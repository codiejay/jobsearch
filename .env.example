# Copy to .env.local. Only ANTHROPIC_API_KEY is needed to start.

# Drafts and form answers. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Sending letters by email from the board. Gmail: an app password, not
# your login password. Leave empty to copy letters instead.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Hosted board only (Vercel + Upstash). Leave empty on a laptop.
# BOARD_PASSWORD=
# BOARD_KEY=
# BOARD_URL=
# JOBSEARCH_STORE=redis
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
