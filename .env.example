# Copy to .env.local. Nothing is needed to start if Claude Code or Codex
# is installed and logged in on this computer.

# Drafts and form answers. With a key, they go through the Anthropic API,
# about 6 cents a role. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Without a key, the board uses Claude Code, or Codex if Claude Code isn't
# installed. That runs on your plan and works only where the board runs
# on your own computer, not hosted. To choose one: api, claude or codex.
# AI=
# Pin a model for the API or Claude Code, or for Codex.
# CLAUDE_MODEL=
# CODEX_MODEL=

# Sending letters by email from the board. Gmail: an app password, not
# your login password. Leave empty to copy letters instead.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Hosted board only (Vercel + Upstash). Leave empty on a laptop.
# BOARD_PASSWORD=
# BOARD_KEY=
# BOARD_URL=
# JOBSEARCH_STORE=redis
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
